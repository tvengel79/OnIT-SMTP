<Window x:Class="OnIT.Smtp.ConfigTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:OnIT.Smtp.ConfigTool.Views"
        Title="OnIT-SMTP Configuration" Height="760" Width="1100" WindowStartupLocation="CenterScreen">
    <TabControl Margin="8">
        <TabItem Header="Entra App">
            <views:EntraAppView DataContext="{Binding EntraApp}"/>
        </TabItem>
        <TabItem Header="Allowed Senders">
            <views:AllowedSendersView DataContext="{Binding AllowedSenders}"/>
        </TabItem>
        <TabItem Header="IP Allow List">
            <views:IpAllowListView DataContext="{Binding IpAllowList}"/>
        </TabItem>
        <TabItem Header="SMTP Listener">
            <views:SmtpListenerView DataContext="{Binding SmtpListener}"/>
        </TabItem>
        <TabItem Header="Logging">
            <views:LoggingView DataContext="{Binding Logging}"/>
        </TabItem>
        <TabItem Header="Test Email">
            <views:TestEmailView DataContext="{Binding TestEmail}"/>
        </TabItem>
        <TabItem Header="Service Status">
            <views:ServiceStatusView DataContext="{Binding ServiceStatus}"/>
        </TabItem>
        <TabItem Header="Docker Export">
            <views:DockerExportView DataContext="{Binding DockerExport}"/>
        </TabItem>
    </TabControl>
</Window>
