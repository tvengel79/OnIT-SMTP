<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>OnIT.Smtp.ConfigTool</RootNamespace>
    <AssemblyName>OnIT.Smtp.ConfigTool</AssemblyName>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <!-- Deliberately not UseWindowsForms: combining it with UseWPF adds implicit global
         usings for both System.Windows and System.Windows.Forms, which makes types present
         in both (Application, UserControl, ...) ambiguous everywhere in this project. The
         one thing WinForms was here for (a folder picker) is covered natively by
         Microsoft.Win32.OpenFolderDialog since .NET 8; see LoggingViewModel. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\favicon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- ApplicationIcon above sets the compiled .exe's own icon (Explorer, taskbar pin);
         Resource here additionally makes both files loadable via a pack:// URI at runtime
         (Assets/favicon.ico for the window's titlebar/taskbar icon, the logo for the
         top-right branding in MainWindow). -->
    <Resource Include="Assets\favicon.ico" />
    <Resource Include="Assets\we_are_on_it_logo.jpg" />
  </ItemGroup>

  <ItemGroup>
    <!-- Microsoft.Extensions.Hosting/Logging.Abstractions are deliberately not referenced
         here: nothing in this project uses the Generic Host, and NullLogger<T> (used in
         EntraAppViewModel) comes transitively through the ProjectReference to Core, which
         already depends on Logging.Abstractions. Adding them directly here previously
         caused an NU1605 package-downgrade error against Core's version. -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OnIT.Smtp.Core\OnIT.Smtp.Core.csproj" />
  </ItemGroup>

</Project>
