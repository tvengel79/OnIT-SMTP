<UserControl x:Class="OnIT.Smtp.ConfigTool.Views.EntraAppView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="16">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="Entra App Registration" Style="{StaticResource SectionHeader}"/>
            <TextBlock Style="{StaticResource Hint}"
                       Text="Creates the Entra ID app registration OnIT-SMTP uses to call Microsoft Graph, activates the Mail.Send application permission, and attempts to grant admin consent automatically. Everything happens directly in the tenant you sign in to below -- nothing is registered outside it, and nothing is shared across customers."/>

            <GroupBox Header="Current status">
                <StackPanel>
                    <TextBlock Text="{Binding IsConfigured, StringFormat='Configured: {0}'}"/>
                    <TextBlock Text="{Binding ApplicationId, StringFormat='Application (client) ID: {0}'}" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding AdminConsentGranted, StringFormat='Admin consent granted: {0}'}" Margin="0,4,0,8"/>

                    <StackPanel Visibility="{Binding CanOpenConsentUrl, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Opens the standard Microsoft consent page in your browser. Sign in as (or already be signed in as) a Global or Application Administrator for this tenant and click Accept -- that's the whole flow."/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Grant consent in browser" Command="{Binding OpenConsentUrlCommand}"/>
                            <Button Content="Check again" Command="{Binding CheckConsentCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Client secret" Visibility="{Binding IsConfigured, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{Binding ClientSecretExpiresOn, StringFormat='Expires: {0:yyyy-MM-dd}'}"/>
                    <TextBlock Margin="0,4,0,8" FontWeight="SemiBold"
                               Visibility="{Binding DaysUntilExpiry, Converter={StaticResource NullToVis}}"
                               Foreground="{Binding DaysUntilExpiry, Converter={StaticResource ExpiryToBrush}}">
                        <Run Text="{Binding DaysUntilExpiry, Mode=OneWay}"/>
                        <Run Text=" day(s) remaining"/>
                    </TextBlock>
                    <Button Content="Renew secret now" Command="{Binding RenewSecretCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" HorizontalAlignment="Left"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Expiry notifications" Visibility="{Binding IsConfigured, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="The service emails these recipients as the secret's expiry gets closer -- at 30, 15, 7, and 3 days out, and again if it actually expires."/>
                    <CheckBox Content="Enabled" IsChecked="{Binding NotificationsEnabled}"/>
                    <TextBlock Text="Notify (comma-separated email addresses)"/>
                    <TextBox Text="{Binding NotificationRecipientsText, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="From address (optional -- defaults to the first enabled allowed sender)"/>
                    <TextBox Text="{Binding NotificationFromAddress, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="Save" Command="{Binding SaveNotificationSettingsCommand}" HorizontalAlignment="Left"/>
                    <TextBlock Text="{Binding NotificationStatusMessage}" Style="{StaticResource StatusLine}"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Create app registration">
                <StackPanel>
                    <TextBlock Text="Tenant ID or domain (e.g. contoso.onmicrosoft.com)"/>
                    <TextBox Text="{Binding TenantId, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Display name"/>
                    <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"/>
                    <CheckBox Content="Sign in with a device code instead of a browser popup" IsChecked="{Binding UseDeviceCodeSignIn}"/>
                    <CheckBox IsChecked="{Binding AttemptAutomaticConsent}">
                        <TextBlock Text="Try to grant admin consent automatically first (uncheck to always use the browser Accept flow instead)" TextWrapping="Wrap" MaxWidth="620"/>
                    </CheckBox>

                    <Expander Header="Advanced: use my own sign-in app instead of Microsoft's" Margin="0,0,0,8">
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="By default, the one-time sign-in used to create the app above goes through Microsoft's own 'Microsoft Graph PowerShell' application -- it's already present in every tenant, so there's nothing to pre-register. If you'd rather your own branding show on that consent screen, register a single-tenant app yourself in this tenant (Entra portal &gt; App registrations &gt; New, 'Accounts in this organizational directory only') with the delegated permissions Application.ReadWrite.All, AppRoleAssignment.ReadWrite.All, Directory.Read.All, User.Read.All, and a 'Mobile and desktop applications' redirect URI of http://localhost, then paste its client ID below."/>
                            <TextBlock Text="Sign-in app client ID (optional)"/>
                            <TextBox Text="{Binding SignInClientIdOverride, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Expander>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Create app" Command="{Binding CreateAppCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
                        <Button Content="Delete app" Command="{Binding DeleteAppCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusLine}"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
