<UserControl x:Class="OnIT.Smtp.ConfigTool.Views.ServiceStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="16">
        <StackPanel MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="Service Status" Style="{StaticResource SectionHeader}"/>

            <GroupBox Header="Windows Service">
                <StackPanel>
                    <TextBlock Text="{Binding IsInstalled, StringFormat='Installed: {0}'}"/>
                    <TextBlock Text="{Binding WindowsServiceStatus, StringFormat='Status: {0}'}" Margin="0,4,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Install" Command="{Binding InstallServiceCommand}"/>
                        <Button Content="Uninstall" Command="{Binding UninstallServiceCommand}"/>
                        <Button Content="Start" Command="{Binding StartServiceCommand}"/>
                        <Button Content="Stop" Command="{Binding StopServiceCommand}"/>
                        <Button Content="Refresh" Command="{Binding RefreshCommand}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusLine}"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Live status (via control pipe)">
                <StackPanel>
                    <TextBlock Text="{Binding IsConnectedToControlPipe, StringFormat='Connected: {0}'}"/>
                    <StackPanel Visibility="{Binding IsConnectedToControlPipe, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding LiveStatus.Listening, StringFormat='Listening: {0}'}" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding LiveStatus.BindAddress, StringFormat='Bind address: {0}'}"/>
                        <TextBlock Text="{Binding LiveStatus.Port, StringFormat='Port: {0}'}"/>
                        <TextBlock Text="{Binding LiveStatus.StartedAt, StringFormat='Started at: {0}'}"/>
                        <TextBlock Text="{Binding LiveStatus.MessagesRelayed, StringFormat='Messages relayed: {0}'}"/>
                        <TextBlock Text="{Binding LiveStatus.MessagesRejected, StringFormat='Messages rejected: {0}'}"/>
                        <TextBlock Text="{Binding LiveStatus.ConnectionsRejectedByIpAllowList, StringFormat='Connections rejected by IP allow list: {0}'}"/>
                        <TextBlock Text="{Binding LiveStatus.EntraAppConfigured, StringFormat='Entra app configured: {0}'}"/>
                        <TextBlock Text="{Binding LiveStatus.AdminConsentGranted, StringFormat='Admin consent granted: {0}'}"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
