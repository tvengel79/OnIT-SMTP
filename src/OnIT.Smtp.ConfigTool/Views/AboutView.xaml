<UserControl x:Class="OnIT.Smtp.ConfigTool.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480">
            <Image Source="/Assets/we_are_on_it_logo.jpg" Height="120" Margin="0,0,0,16"/>

            <TextBlock Text="{Binding ProductName}" FontSize="24" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,0,0,4"/>
            <TextBlock Text="{Binding Version}" Foreground="Gray" HorizontalAlignment="Center" Margin="0,0,0,16"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock VerticalAlignment="Center">
                    <Run Text="Copyright"/>
                    <Run Text="{Binding CopyrightYears, Mode=OneWay}"/>
                </TextBlock>
                <TextBox x:Name="OnItBelgiumTextBox" Text="OnIT Belgium" IsReadOnly="True" IsUndoEnabled="False"
                         BorderThickness="0" Background="Transparent" Padding="4,0,0,0" Margin="0"
                         VerticalAlignment="Center" VerticalContentAlignment="Center" Cursor="IBeam"
                         SelectionChanged="OnItBelgiumTextBox_SelectionChanged"/>
            </StackPanel>

            <TextBlock Text="All rights reserved." Foreground="Gray" HorizontalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
