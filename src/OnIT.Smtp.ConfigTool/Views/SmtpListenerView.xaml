<UserControl x:Class="OnIT.Smtp.ConfigTool.Views.SmtpListenerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="16">
        <StackPanel MaxWidth="480" HorizontalAlignment="Left">
            <TextBlock Text="SMTP Listener" Style="{StaticResource SectionHeader}"/>
            <TextBlock Style="{StaticResource Hint}"
                       Text="Where the service listens for plain SMTP from your LAN. Clients still have to pass the IP allow list to relay anything."/>

            <TextBlock Text="Bind address (0.0.0.0 for all interfaces)"/>
            <TextBox Text="{Binding BindAddress, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="Port"/>
            <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="Maximum message size (MB, 0 = unlimited)"/>
            <TextBox Text="{Binding MaxMessageSizeMb, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="Session idle timeout (seconds)"/>
            <TextBox Text="{Binding SessionTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="Server host name (used in SMTP banners)"/>
            <TextBox Text="{Binding ServerHostName, UpdateSourceTrigger=PropertyChanged}"/>

            <Button Content="Save" Command="{Binding SaveCommand}" HorizontalAlignment="Left"/>
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusLine}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
