<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>OnIT.Smtp.Core</RootNamespace>
    <AssemblyName>OnIT.Smtp.Core</AssemblyName>
    <!-- Kept cross-platform (no *-windows TFM) on purpose: this library is shared
         with the Part 2 Docker/Linux bridge, including secret protection --
         PortableSecretProtector uses a portable, non-machine-bound key file (AES-256-GCM)
         rather than an OS-specific mechanism like Windows DPAPI, precisely so a config
         directory can be copied to another machine (or into the Part 2 container) and its
         encrypted client secret still decrypts there without re-entering anything. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Graph" Version="5.61.0" />
    <PackageReference Include="Azure.Identity" Version="1.12.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.1" />
    <PackageReference Include="Serilog" Version="4.0.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="System.IO.FileSystem.AccessControl" Version="5.0.0" />
  </ItemGroup>

</Project>
